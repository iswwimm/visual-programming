<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DnaSequencer.MainWindow"
        Title="Prosty Sekwencer DNA" Width="400" Height="450">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Wprowadź sekwencję DNA (A, C, G, T):" FontWeight="Bold"/>

        <TextBox x:Name="DnaInputTextBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" />

        <Button Content="Analizuj sekwencję" Click="ButtonClicked" HorizontalAlignment="Center" />
        
        <TextBlock Text="Wyniki (sekwencje 4-nukleotydowe):" FontWeight="Bold" Margin="0,10,0,0"/>
        <ScrollViewer Height="150">
            <TextBlock x:Name="ResultsTextBlock" TextWrapping="Wrap" />
        </ScrollViewer>
    </StackPanel>

</Window>
