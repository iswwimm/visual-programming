<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BioNotepad.ViewModels"
             xmlns:models="using:BioNotepad.Models"
             x:Class="BioNotepad.Views.SessionDetailView"
             x:DataType="vm:SessionDetailViewModel"
             Name="SessionDetailRoot">

    <Grid RowDefinitions="Auto, Auto, *" Margin="20">
        
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,20">
            <Button Grid.Column="0" Content="← Wróć" Command="{Binding GoBackCommand}" Margin="0,0,15,0" />
            <TextBlock Grid.Column="1" Text="{Binding Session.Title}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Eksportuj do PDF" Click="OnExportPdfClick" Classes="accent" Background="#007ACC" Foreground="White" />
        </Grid>

        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <StackPanel Spacing="10">
                <TextBlock Text="Nowy wpis analityczny:" FontWeight="SemiBold"/>
                <TextBox Text="{Binding NewEntryDescription}" AcceptsReturn="True" Height="80" 
                         Watermark="Opisz wyniki eksperymentu lub parametry uruchomienia skryptu..." />
                <Button Content="Dodaj Wpis" Command="{Binding AddEntryCommand}" HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SessionEntry">
                        <Border Background="#2D2D30" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding CreatedAt}" FontSize="12" Foreground="LightGray" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                
                                <ItemsControl ItemsSource="{Binding Attachments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,5,0,0">
                                                <TextBlock Text="📎" />
                                                <TextBlock Text="{Binding FileName}" Foreground="#4DA6FF" FontStyle="Italic"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="+ Dodaj plik (np. .fasta, .png)" 
                                        Click="OnAddAttachmentClick" 
                                        Tag="{Binding}" 
                                        Margin="0,10,0,0" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>