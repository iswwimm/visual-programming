<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BioNotepad.ViewModels"
             x:Class="BioNotepad.Views.SessionListView"
             x:DataType="vm:SessionListViewModel"
             Name="SessionListRoot">

    <Grid RowDefinitions="Auto, *" Margin="20">
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
            <TextBox Text="{Binding NewSessionTitle}" 
                     Watermark="Tytuł nowej sesji analitycznej (np. Wyrównanie sekwencji BRCA1)" 
                     Width="400" />
            <Button Content="Utwórz Sesję" Command="{Binding CreateSessionCommand}" Classes="accent"/>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2D2D30" CornerRadius="8" Padding="15" Margin="0,5">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="White" />
                                <TextBlock Text="{Binding CreatedAt}" FontSize="12" Foreground="LightGray" Margin="0,5,0,0" />
                            </StackPanel>
                            
                            <Button Grid.Column="1" Content="Otwórz" 
                                    Command="{Binding #SessionListRoot.((vm:SessionListViewModel)DataContext).OpenSessionCommand}" 
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>