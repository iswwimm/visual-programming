<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start Gry" Height="450" Width="300">
    <StackPanel Margin="20">

        <TextBlock Text="Liczba wierszy:"/>
        <TextBox x:Name="RowsBox" Text="3"/>

        <TextBlock Text="Liczba kolumn:" Margin="0,10,0,0"/>
        <TextBox x:Name="ColsBox" Text="3"/>
        
        <TextBlock Text="Czas gry (sekundy):" Margin="0,10,0,0"/>
        <TextBox x:Name="TimeBox" Text="30"/>

        <TextBlock Text="Liczba Hyrax:" Margin="0,10,0,0"/>
        <TextBox x:Name="HyraxBox" Text="3"/>

        <TextBlock Text="Liczba Szopów:" Margin="0,10,0,0"/>
        <TextBox x:Name="RaccoonBox" Text="2"/>

        <TextBlock Text="Liczba Krokodyli:" Margin="0,10,0,0"/>
        <TextBox x:Name="CrocodileBox" Text="1"/>

        <Button Content="Start" Margin="0,20,0,0" Click="StartButton_Click"/>
    </StackPanel>
</Window>